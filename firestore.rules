rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // FUNGSI PEMBANTU: Cek apakah user adalah Admin terautentikasi (Firebase Auth)
    function isAdmin() {
      return request.auth != null;
    }

    // 1. Koleksi log_absensi: Siswa bisa kirim log & baca history, Admin bebas kelola.
    match /log_absensi/{docId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // 2. Koleksi sesi_absensi: Siswa baca status sesi, Admin kelola sesi.
    match /sesi_absensi/{docId} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }

    // 3. Koleksi siswa: Siswa baca profil & ikat device, Admin kelola master data.
    match /siswa/{docId} {
      allow read, update: if true;
      allow create, delete: if isAdmin();
    }

    // 4. Koleksi publik (Read-Only untuk Siswa, Write untuk Admin)
    match /kelas/{docId} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    match /mapel/{docId} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    match /links/{docId} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write, update, delete: if isAdmin();
    }

    // 5. Koleksi SENSITIF (HANYA ADMIN): Log keamanan, recycle bin, & daftar device admin.
    match /admin_devices/{docId} {
      allow read, write, update, delete: if isAdmin();
    }
    match /system_logs/{docId} {
      allow read, write, update, delete: if isAdmin();
    }
    match /trash_bin/{docId} {
      allow read, write, update, delete: if isAdmin();
    }
  }
}
